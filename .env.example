# Cómo se autentican los agentes con Claude:
#   subscription -> usa tu sesión local de Claude Code (plan Pro/Max). Uso personal.
#   apikey       -> usa ANTHROPIC_API_KEY (para un despliegue futuro).
ORDEN_AUTH_MODE=subscription
# ANTHROPIC_API_KEY=sk-ant-...

# Ruta de la base de datos SQLite compartida entre la web y el worker.
# ORDEN_DB_PATH=./data/orden.db

# Encargos que el worker ejecuta a la vez.
# ORDEN_MAX_CONCURRENCY=3
